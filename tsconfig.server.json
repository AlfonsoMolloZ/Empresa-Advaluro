{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["server"],
  // Estas dos pruebas importan código de `src`, que usa imports sin extensión
  // porque lo empaqueta Vite. Si se compilaran aquí, `nodenext` las marcaría
  // como error aunque en la aplicación funcionen. Se comprueban en
  // `tsconfig.pruebas.json`, que resuelve los dos estilos a la vez.
  "exclude": ["server/prueba-calculos.ts", "server/prueba-dataset.ts"]
}
