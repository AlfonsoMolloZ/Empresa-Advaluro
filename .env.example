# Configuración local. Copia este archivo a .env y ajusta los valores.
# .env está en .gitignore: nunca se sube al repositorio.

# Dónde vive el archivo de la base de datos SQLite.
# Es un archivo normal: copiarlo es tu respaldo.
DATABASE_URL=archivo:data/advaluro.db

# Puerto de la API local. El frontend de Vite lo usa como destino en desarrollo.
API_PORT=8787

# Solo para la primera cuenta de administrador, si prefieres fijar la contraseña
# en vez de dejar que la genere el servidor. Se aplica únicamente cuando la base
# todavía no tiene ningún usuario; después estos valores ya no tienen efecto.
# Si lo dejas vacío o no existe, el servidor genera una contraseña al azar y la
# muestra una sola vez en la consola al arrancar.
#ADMIN_EMAIL=admin@advaluro.pe
#ADMIN_PASSWORD=

# Días que una sesión iniciada permanece abierta antes de pedir la contraseña otra vez.
SESION_DIAS=7

# Zona horaria usada para agrupar los gastos por mes y contar los días del mes.
TZ=America/Lima
